# Copy to .env.local and fill in from your Supabase project settings.
# Both of these are safe to expose in the browser by design - the security
# boundary is Postgres Row Level Security, not key secrecy. See supabase/schema.sql.
#
# NEVER put the service_role key in a NEXT_PUBLIC_ variable. It bypasses RLS.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
